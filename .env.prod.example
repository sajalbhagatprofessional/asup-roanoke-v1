# ASUP Roanoke v1.0 Production Environment Variables
# Target: Oracle Cloud Infrastructure (OCI) Ampere A1 ARM64 (Ubuntu 24.04 LTS)

ASUP_DOMAIN=localhost
POSTGRES_USER=asup_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_SECRET_32_CHARS
POSTGRES_DB=asup_roanoke
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_SECRET_32_CHARS
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_SECRET_32_CHARS@redis:6379/0

PII_VAULT_KEY=0123456789abcdef0123456789abcdef
PACER_DAILY_CAP_USD=3.00
KILL_SWITCH_MEMO_DRAFTER=false
OUTREACH_GLOBAL_FREEZE=0
FASTAPI_URL=http://fastapi:8000
NEXT_PUBLIC_API_URL=

# Google OAuth 2.0 Identity Services (Optional / Plug-and-Play)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
